{
  "name": "context-retriever-mcp",
  "version": "1.1.0",
  "description": "Local vector retrieval MCP server for coding agents: semantic code search, session-transcript memory, and a live token-savings counter. 100% on-device.",
  "license": "MIT",
  "author": "Hamza Abid",
  "repository": {
    "type": "git",
    "url": "https://github.com/sara-hamza/context-retriever.git"
  },
  "keywords": ["mcp", "retrieval", "rag", "claude-code", "semantic-search", "embeddings", "local-first"],
  "type": "module",
  "bin": {
    "context-retriever": "dist/index.js"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "test": "vitest run",
    "serve": "tsx src/index.ts",
    "cli": "tsx src/cli.ts",
    "warmup-memory": "tsx src/warmup-memory.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.4.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.23.11",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
